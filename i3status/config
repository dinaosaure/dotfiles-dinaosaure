general {
    colors = true
    interval = 5

    color_good     = "#4a2c3a"
    color_degraded = "#8a5a6e"
    color_bad      = "#c2185b"
}

order += "wireless wlan0"
order += "battery all"
order += "volume master"
order += "tztime local"

wireless wlan0 {
    format_up = "WiFi: %essid"
    format_down = "WiFi: off"
}

battery all {
    format = "Bat: %percentage"
}

volume master {
    format = "Vol: %volume"
    format_muted = "Vol: muted"
}

tztime local {
    format = "%d/%m %H:%M"
}
